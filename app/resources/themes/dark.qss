/* Project Apogee -- Dark theme */

QWidget {
    background-color: #1e1f26;
    color: #e6e6e6;
    selection-background-color: #3d7cf4;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #1e1f26;
}

QMenuBar {
    background-color: #262832;
    color: #e6e6e6;
}
QMenuBar::item:selected {
    background-color: #3d7cf4;
}
QMenu {
    background-color: #262832;
    border: 1px solid #3a3d4a;
}
QMenu::item:selected {
    background-color: #3d7cf4;
}

QToolBar {
    background-color: #262832;
    border: none;
    spacing: 4px;
}

QDockWidget {
    titlebar-close-icon: none;
    color: #e6e6e6;
}
QDockWidget::title {
    background-color: #262832;
    padding: 6px;
}

QPushButton {
    background-color: #2c2f3a;
    border: 1px solid #3a3d4a;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background-color: #343848;
    border-color: #3d7cf4;
}
QPushButton:pressed {
    background-color: #3d7cf4;
}
QPushButton:disabled {
    color: #6b6f7a;
    background-color: #262832;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #14151a;
    border: 1px solid #3a3d4a;
    border-radius: 3px;
    padding: 3px;
}
QComboBox QAbstractItemView {
    background-color: #262832;
    selection-background-color: #3d7cf4;
}

QTableView, QTreeView, QListView {
    background-color: #14151a;
    alternate-background-color: #1a1b22;
    gridline-color: #3a3d4a;
    border: 1px solid #3a3d4a;
}
QHeaderView::section {
    background-color: #262832;
    color: #e6e6e6;
    padding: 4px;
    border: 1px solid #3a3d4a;
}

QTabWidget::pane {
    border: 1px solid #3a3d4a;
}
QTabBar::tab {
    background-color: #262832;
    padding: 6px 12px;
}
QTabBar::tab:selected {
    background-color: #3d7cf4;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #1e1f26;
}
QScrollBar::handle {
    background: #3a3d4a;
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: #3d7cf4;
}

QStatusBar {
    background-color: #262832;
}
